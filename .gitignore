# OS files
.DS_Store
Thumbs.db
desktop.ini

# Large binary files — camera/flash manuals (keep locally, too large for git)
reference/manuals/*.pdf

# Legacy PDFs and presentations (keep locally)
reference/legacy/**/*.pdf
reference/legacy/**/*.pptx

# Binary libraries
*.dll
*.lib
*.exe

# ExifTool bin folder is downloaded by setup script, not committed
tools/nks_focus_culler/bin/

# Photo review samples (large files, local only)
review/

# Log files
*.log

# Nuitka build artifacts
tools/nks_focus_culler/dist/
tools/nks_focus_culler/*.build/
tools/nks_focus_culler/*.onefile-build/
tools/nks_focus_culler/*.dist/

